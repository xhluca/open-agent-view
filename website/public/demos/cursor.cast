[21.504981, "o", "\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[1A\u001b[2K\u001b[G  Hello! How can I help you today?\r\n\r\n \u001b[33m┌─ follow-ups ─────────────────────────────────────────────────────────────────────────────────────────────────────────────────┐\u001b[39m\r\n \u001b[33m│ \u001b[39m\u001b[2m○ Explain what is Cursor                                                                                                    \u001b[22m\u001b[33m │\u001b[39m\r\n \u001b[33m│ \u001b[39m\u001b[2menter steer · ↑ select/edit · esc cancel                                                                                    \u001b[22m\u001b[33m │\u001b[39m\r\n \u001b[33m└──────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────┘\u001b[39m\r\n\r\n \u001b[32m⠘⠆\u001b[39m \u001b[1mWorking\u001b[22m \u001b[2m 6 tokens\u001b[22m\r\n  \u001b[38;5;245m  Tip: Use /debug to instrument and debug complex problems.\u001b[39m\r\n\r\n \u001b[48;2;21;21;21m                                                                                                                                  \u001b[49m\r\n \u001b[48;2;21;21;21m \u001b[2m→ \u001b[22m\u001b[7mA\u001b[27m\u001b[2mdd a follow-up\u001b[22m                                                                                                 \u001b[2mctrl+c to stop\u001b[22m \u001b[49m\r\n \u001b[48;2;21;21;21m                                                                                                                                  \u001b[49m\r\n\r\n  \u001b[2mAuto\u001b[22m\r\n  \u001b[2m~/work/acme-dashboard\u001b[22m\r\n"]
