[24.7408, "o", "\r\n\u001b[15;1H\u001b[39;49mType \u001b[0m\u001b[15;6H\u001b[36;49m/help\u001b[0m\u001b[15;11H\u001b[39;49m for more information\u001b[0m\u001b[15;32H\u001b[49m                    \u001b[0m\u001b[15;52H\u001b[49m \u001b[0m\u001b[15;53H\u001b[39;49m                                                                                \u001b[0m\r\n\u001b[16;1H\u001b[49m                                                                                                                                    \u001b[0m\r\n\u001b[17;1H\u001b[49m                                                                                                                                    \u001b[0m\r\n\u001b[18;1H\u001b[39;49m\u001b[0m\u001b[49m                                                                                                                                    \u001b[0m\r\n\u001b[19;1H\u001b[1;38;2;255;130;5;49m> \u001b[0m\u001b[19;3H\u001b[1;39;49mhello\u001b[0m\u001b[49m                                                                                                                             \u001b[0m\r\n\u001b[20;1H\u001b[2;39;49m────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[0m\r\n\u001b[21;1H\u001b[49m                                                                                                                                    \u001b[0m\r\n\u001b[22;1H\u001b[49m  \u001b[0m\u001b[22;3H\u001b[39;49mHello! How can I help you today?\u001b[0m\u001b[49m                                                                                                \u001b[0m\u001b[22;131H\u001b[49m  \u001b[0m\r\n\u001b[23;1H\u001b[49m                                                                                                                                    \u001b[0m\r\n\u001b[24;1H\u001b[39;49m\u001b[0m\u001b[49m                                                                             