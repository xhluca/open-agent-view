[19.414824, "o", "\u001b[?2026h\u001b[13A\r\u001b[2K \u001b[38;2;79;168;255m│\u001b[39m  \u001b[1m\u001b[38;2;136;136;136mSession:   \u001b[39m\u001b[22msession_5b8d55da-8c38-4789-8fb9-6c1582a611d6                                                                       \u001b[38;2;79;168;255m│\u001b[39m\u001b[0m\u001b]8;;\u0007\r\r\n\u001b[2K \u001b[38;2;79;168;255m│\u001b[39m  \u001b[1m\u001b[38;2;136;136;136mModel:     \u001b[39m\u001b[22mGPT-5.4                                                                                                            \u001b[38;2;79;168;255m│\u001b[39m\u001b[0m\u001b]8;;\u0007\r\r\n\u001b[2K \u001b[38;2;79;168;255m│\u001b[39m  \u001b[1m\u001b[38;2;136;136;136mVersion:   \u001b[39m\u001b[22m0.39.1                                                                                                             \u001b[38;2;79;168;255m│\u001b[39m\u001b[0m\u001b]8;;\u0007\r\r\n\u001b[2K \u001b[38;2;79;168;255m│\u001b[39m                                                                                                                                \u001b[38;2;79;168;255m│\u001b[39m\u001b[0m\u001b]8;;\u0007\r\r\n\u001b[2K \u001b[38;2;79;168;255m╰────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────╯\u001b[39m\u001b[0m\u001b]8;;\u0007\r\r\n\u001b[2K \u001b[0m\u001b]8;;\u0007\r\r\n\u001b[2K \u001b[38;2;79;168;255m\u001b[1m✦ Try Kimi Code Web UI\u001b[22m\u001b[39m \u001b[38;2;245;245;245m\u001b[1m- clearer task progress, visual sessions & settings management\u001b[22m\u001b[39m\u001b[0m\u001b]8;;\u0007\r\r\n\u001b[2K   \u001b[38;2;136;136;136mRun /web to continue your session in the browser\u001b[39m\u001b[0m\u001b]8;;\u0007\r\r\n\u001b[2K \u001b[0m\u001b]8;;\u0007\r\r\n\u001b[2K   \u001b[38;2;136;136;136mNo session yet — one will be created on your first message.\u001b[39m                                                                     \u001b[0m\u001b]8;;\u0007\r\r\n\u001b[2K   \u001b[38;2;232;168;56mtmux extended-keys is off. Modified Enter keys may not work. Add `set -g extended-keys on` to ~/.tmux.conf and restart tmux.\u001b[39m    \u001b[0m\u001b]8;;\u0007\r\r\n\u001b[2K\u001b]133;A\u0007 \u001b[0m\u001b]8;;\u0007\r\r\n\u001b[2K\u001b]133;B\u0007\u001b]133;C\u0007 \u001b[38;2;255;203;107m\u001b[1m✨ \u001b[22m\u001b[39m\u001b[38;2;255;203;107m\u001b[1mhello\u001b[22m\u001b[39m                                                                                                                          \u001b[0m\u001b]8;;\u0007\r\r\n\u001b[2K \u001b[0m\u001b]8;;\u0007\r\r\n\u001b[2K  🌑\u001b[38;2;136;136;136m · Tip: ask Kimi to schedule tasks, e.g. \"remind me at 5pm\"\u001b[39m                                                                    \u001b[0m\u001b]8;;\u0007\r\r\n\u001b[2K \u001b[38;2;90;90;90m──────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[39m\u001b[0m\u001b]8;;\u0007\r\r\n\u001b[2K \u001b[38;2;91;192;190m  ❯ Explain what is Kimi Code\u001b[39m\u001b[0m\u001b]8;;\u0007\r\r\n\u001b[2K \u001b[38;2;136;136;136m  ↑ to edit · ctrl-s to steer immediately\u001b[39m\u001b[0m\u001b]8;;\u0007\r\r\n\u001b[2K \u001b[38;2;90;90;90m╭────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────╮\u001b[39m\u001b[0m\u001b]8;;\u0007\r\r\n\u001b[2K \u001b[38;2;90;90;90m│\u001b[39m > Now, I can navigate back to panel with Shift + Left Arrow\u001b[7m \u001b[0m                                                                   \u001b[38;2;90;90;90m│\u001b[39m\u001b[0m\u001b]8;;\u0007\r\r\n\u001b[2K \u001b[38;2;90;90;90m╰────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────╯\u001b[39m\u001b[0m\u001b]8;;\u0007\r\r\n\u001b[2K \u001b[38;2;224;224"]
