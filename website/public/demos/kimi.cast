[10.767123, "o", "\u001b[?2004l\u001b[?1000l\u001b[?1002l\u001b[?1003l\u001b[?1006l\u001b[<u\u001b[?25h\u001b[?1049h\u001b[?25l\u001b[2J"]
[10.767529, "o", "\u001b[1;1H\u001b[38;2;89;194;201m\u001b[48;2;24;26;27m  ◇◇  \u001b[1m\u001b[38;2;205;205;205m\u001b[48;2;24;26;27mOpen Agent View v0.1.36\u001b[22m                                                                                                       \u001b[2;1H\u001b[38;2;89;194;201m\u001b[48;2;24;26;27m ◇  ◇ \u001b[38;2;145;145;145m\u001b[48;2;24;26;27mCoding agents · ~/work/acme-dashboard\u001b[38;2;205;205;205m\u001b[48;2;24;26;27m                                                                                         \u001b[3;1H\u001b[38;2;89;194;201m\u001b[48;2;24;26;27m  ◇◇  \u001b[38;2;145;145;145m\u001b[48;2;24;26;27m0 awaiting input · 0 working · 0 completed (/completed hide) · status view\u001b[38;2;205;205;205m\u001b[48;2;24;26;27m                                                    \u001b[4;1H                                                                                                                                    \u001b[5;1H\u001b[1mNeeds input\u001b[22m                                                                                                                         \u001b[6;1H\u001b[38;2;145;145;"]
[10.767819, "o", "145m\u001b[48;2;24;26;27m Sessions that have a question or need your decision land here\u001b[38;2;205;205;205m\u001b[48;2;24;26;27m                                                                      \u001b[7;1H                                                                                                                                    \u001b[8;1H\u001b[1mWorking\u001b[22m                                                                                                                             \u001b[9;1H\u001b[38;2;145;145;145m\u001b[48;2;24;26;27m Sessions your coding agents are actively working on\u001b[38;2;205;205;205m\u001b[48;2;24;26;27m                                                                                \u001b[10;1H                                                                                                                                    \u001b[11;1H\u001b[1mCompleted\u001b[22m                                                                                                                           \u001b[12;1H\u001b[38;2;145;145;145m\u001b[48;2;24;26;27m Finished sessions wait here for you to review\u001b[38;2;205;205;205m\u001b[48;2;24;26;27m                                                                                      \u001b[13;1H                                                                                                                                    \u001b[14;1H\u001b[38;2;145;145;145m\u001b[48;2;24;26;27mHand off a substantial task below. Open Agent View will organize it by status so you can see when it needs you.\u001b[38;2;205;205;205m\u001b[48;2;24;26;27m                     \u001b[15;1H                                                                                                                                    \u001b[16;1H                                                                                                                                    \u001b[17;1H                                                                                                                                    \u001b[18;1H                                                                                                                                    \u001b[19;1H                                                                                                                                    \u001b[20;1H                                                                                                                                    \u001b[21;1H                                                                                                                                    \u001b[22;1H                                                                                                                                    \u001b[23;1H                                                                                                                                    \u001b[24;1H                                                                                                                                    \u001b[25;1H                                                                                                                                    \u001b[26;1H                                                                                                                                    \u001b[27;1H                                                                                                                                    \u001b[28;1H                                                                                                                                    \u001b[29;1H                                                                                                                                    \u001b[30;1H                                                                                                                                    \u001b[31;1H\u001b[38;2;145;145;145m\u001b[48;2;24;26;27m─────────────────────────────────────────────────────────────────────────────────────────────────────"]
[10.767944, "o", "───────────────────────────────\u001b[32;1H\u001b[38;2;205;205;205m\u001b[48;2;24;26;27m❯ \u001b[38;2;145;145;145m\u001b[48;2;24;26;27mdescribe a task · /help for commands\u001b[38;2;205;205;205m\u001b[48;2;24;26;27m                                                                                              \u001b[33;1H\u001b[38;2;145;145;145m\u001b[48;2;24;26;27m────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[34;1Hbackgrounded Kimi Code setup; run `/setup kimi` to resume it                                                                        \u001b[39m\u001b[49m\u001b[59m\u001b[0m\u001b[?25l"]
[10.818142, "o", "\u001b[2;7H\u001b[38;2;145;145;145m\u001b[48;2;24;26;27mTerminal · ~/work\u001b[2;25Hacme-dashbo\u001b[2;37Hrd\u001b[38;2;205;205;205m\u001b[48;2;24;26;27m     \u001b[3;26H\u001b[38;2;145;145;145m\u001b[48;2;24;26;27m1\u001b[5;1H\u001b[1m\u001b[38;2;205;205;205m\u001b[48;2;24;26;27mWorking\u001b[22m    \u001b[6;1H\u001b[38;2;89;194;201m\u001b[48;2;58;60;61m ✳ \u001b[1m\u001b[38;5;15m\u001b[48;2;58;60;61mKimi Code setup           \u001b[22m\u001b[38;2;89;194;201m\u001b[48;2;58;60;61m Terminal       \u001b[38;2;145;145;145m\u001b[48;2;58;60;61mInteractive provider setup · Enter resumes · Ctrl+X stops                             —\u001b[8;1H\u001b[38;2;205;205;205m\u001b[48;2;24;26;27m       \u001b[9;1H                                                    \u001b[11;1H         \u001b[12;1H                                              \u001b[14;1H                                                                                                               \u001b[39m\u001b[49m\u001b[59m\u001b[0m\u001b[?25l"]
