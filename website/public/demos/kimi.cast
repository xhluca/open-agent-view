[5.564231, "o", "\u001b[1;36m==>\u001b[0m Installed to ~/.kimi-code/bin/kimi\r\n\u001b[1;36m==>\u001b[0m Skipping PATH update (KIMI_NO_MODIFY_PATH set)\r\n"]
